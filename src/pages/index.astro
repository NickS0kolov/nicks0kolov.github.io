---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
const projects = Object.values(import.meta.glob('./projects/*.md', { eager: true }));
---
<Base>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="red-dot"></span> AI & ROBOTICS</p><h1>Learning how<br />machines <em>learn.</em></h1><p class="hero-description">I'm Nick Sokolov, an&nbsp;ML research engineer working on&nbsp;multimodal learning and&nbsp;embodied AI.<br />I&nbsp;focus on&nbsp;vision&#8209;language&#8209;action models and&nbsp;robotic manipulation, and&nbsp;investigate how AI models perceive, reason, and&nbsp;represent the&nbsp;world.</p><div class="hero-actions"><a class="primary-link" href="/projects/">Explore my work</a><a class="text-link" href="https://www.kaggle.com/nickr0ot" target="_blank" rel="noopener noreferrer">Kaggle</a><a class="text-link" href="https://medium.com/@sokolovnick" target="_blank" rel="noopener noreferrer">Medium</a><a class="text-link" href="mailto:sokolovnickjob@gmail.com">Email</a></div></div>
    <div class="hero-art"><img src="/images/robot-manipulation-transparent.png" alt="Line illustration of a robotic arm reaching for a cube, with a red motion trajectory" width="1448" height="1086" /><div class="plot-caption"><span>FIG. 01 — PERCEPTION TO ACTION</span></div></div>
  </section>
  <div class="research-strip"><span class="strip-label">AREAS OF INTEREST</span><ul class="research-interests"><li>Vision-Language-Action Models (VLA)</li><li>World Action Models (WAM)</li><li>AI Cognition &amp; Interpretability</li><li>Vision-Language Models (VLM)</li><li>Robot Learning</li></ul></div>
  <section class="work-section"><div class="section-heading"><div><p class="eyebrow">THE RESEARCH NOTEBOOK</p><h2>Selected explorations</h2></div><a class="text-link" href="/projects/">All projects</a></div><div class="project-grid">{projects.map((entry, index) => <Card entry={entry} index={index} />)}</div></section>
</Base>
